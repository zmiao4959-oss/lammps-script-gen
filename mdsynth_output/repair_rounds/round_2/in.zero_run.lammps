# LAMMPS input script for bicrystal Fe phase transformation simulation
# Material: iron (Fe), bcc, lattice constant 2.866 Å

# --------------------- Initialization ---------------------
units metal
atom_style atomic
boundary p p p

# --------------------- Simulation cell ---------------------
# Box size: x = 100 Å, y = 20 Å, z = 20 Å
region box block 0 100 0 20 0 20 units box
create_box 1 box

# --------------------- Bicrystal construction ---------------------
# Left grain (x = 0 to 50) with [100] orientation
region left block 0 50 0 20 0 20 units box
lattice bcc 2.866 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
create_atoms 1 region left

# Right grain (x = 50 to 100) rotated 15° about z-axis
region right block 50 100 0 20 0 20 units box
lattice bcc 2.866 orient x 0.9659258 0.2588190 0 orient y -0.2588190 0.9659258 0 orient z 0 0 1
create_atoms 1 region right

# Remove overlapping atoms at the grain boundary
delete_atoms overlap 0.5 all all

# --------------------- Material properties & potential ---------------------
mass 1 55.845
pair_style eam
pair_coeff * * Fe_mm.eam.fs

# --------------------- Initial velocites and energy minimization ---------------------
velocity all create 300.0 12345
minimize 1.0e-6 1.0e-8 10000 100000

# --------------------- Output settings ---------------------
thermo 100
thermo_style custom step temp pe ke etotal press vol lx ly lz density
dump d1 all custom 1000 dump.bicrystal_Fe.lammpstrj id type x y z

# --------------------- Phase transition via NPT heating ---------------------
variable T0 equal 300.0
variable T1 equal 1200.0
variable P equal 0.0
fix fxnpt all npt temp ${T0} ${T1} 0.1 iso ${P} ${P} 1.0

run 0