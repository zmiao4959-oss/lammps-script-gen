# LAMMPS input script for bicrystal Fe phase transformation simulation
# Material: iron (Fe), bcc, lattice constant 2.866 Å

# --------------------- Initialization ---------------------
units metal
atom_style atomic
boundary p p p

# --------------------- Simulation cell ---------------------
# Box size: x = 100 Å, y = 20 Å, z = 20 Å
region box block 0 100 0 20 0 20 units box
create_box 1 box
Created orthogonal box = (0 0 0) to (100 20 20)
  1 by 1 by 1 MPI processor grid

# --------------------- Bicrystal construction ---------------------
# Left grain (x = 0 to 50) with [100] orientation
region left block 0 50 0 20 0 20 units box
lattice bcc 2.866 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
Lattice spacing in x,y,z = 2.866 2.866 2.866
create_atoms 1 region left
