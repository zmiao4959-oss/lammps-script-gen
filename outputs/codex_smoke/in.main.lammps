# ========================================
# LAMMPS input script generated by MDSynth v0.1.0
# Task type: equilibration_npt
# Material: copper
# ========================================

clear
units metal # metal units: eV, Å, ps, K, bar
atom_style atomic # atomic style for metal
boundary p p p # p = periodic
lattice fcc 3.615 # fcc lattice, a0 = 3.615 Å
region simbox block 0 10 0 10 0 10 # simulation box: 10x10x10 unit cells
create_box 1 simbox
create_atoms 1 region simbox # copper atoms
mass 1 63.546 # Cu (bulk_atom)
pair_style eam # eam potential
pair_coeff * * Cu_u3.eam # source: builtin
neighbor 2.0 bin # skin distance for neighbor list build
neigh_modify delay 0 every 1 check yes # rebuild neighbor list every step during equilibration
timestep 0.001 # 0.001 ps = 1.0 fs
minimize 1e-06 1e-08 10000 100000 # energy minimization (etol=1e-06, ftol=1e-08)
velocity all create 300.0 559720878 dist gaussian # initialize velocities at 300.0 K
fix fx_equil all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0 # NPT at 300.0 K, Tdamp = 0.1 ps, Pdamp = 1.0 ps
run 200000 # equilibrate for 200000 steps
unfix fx_equil # remove fx_equil fix
thermo 100 # output thermodynamics every N steps
thermo_style custom step temp pe ke etotal press vol lx ly lz density # thermodynamic fields to output
dump dump_all all custom 1000 dump.custom # trajectory dump
dump_modify dump_all sort id # sort output by atom ID
write_restart final.restart # write final restart file
