# ========================================
# LAMMPS input script generated by MDSynth
# Task type: equilibration_npt
# Material: copper
# ========================================

clear
units metal
atom_style atomic
boundary p p p

# ---------- system ----------
lattice fcc 3.615
region simbox block 0 10 0 10 0 10
create_box 1 simbox
create_atoms 1 region simbox

# ---------- force field ----------
mass 1 63.546
pair_style eam
pair_coeff * * Cu_u3.eam

# ---------- neighbor ----------
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# ---------- protocol ----------
timestep 0.001
minimize 1e-06 1e-08 10000 100000
velocity all create 300 4928459 dist gaussian
fix fx_equil all npt temp 300 300 0.1 iso 0.0 0.0 1.0
run 200000
unfix fx_equil

# ---------- output ----------
thermo 100
thermo_style custom step temp pe ke etotal press vol lx ly lz density
dump dump_all all custom 1000 dump.custom
dump_modify dump_all sort id
write_restart final.restart
